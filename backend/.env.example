# === Inclua Beauty AI — variáveis de ambiente ===

# Banco de dados. Local (default): SQLite. Produção: Cloud SQL (PostgreSQL+pgvector).
# Ex. Postgres: postgresql+psycopg://ib_app:senha@127.0.0.1:5432/incluabeauty
DATABASE_URL=sqlite:///./incluabeauty.db

# Segurança
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# Motor de análise: "heuristic" (default, roda sem credenciais) ou "adk" (Gemini/Vertex).
ANALYSIS_ENGINE=heuristic

# --- Camada agêntica (usada quando ANALYSIS_ENGINE=adk) ---
# Opção A: Vertex AI (recomendado em produção GCP)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Opção B: Gemini API key (dev rápido)
GOOGLE_API_KEY=

MODEL_FAST=gemini-2.5-flash
MODEL_PRO=gemini-2.5-pro

# Seed de dados de demonstração no startup (org + usuário + produto exemplo)
SEED_DEMO=true
DEMO_EMAIL=demo@incluabeauty.ai
DEMO_PASSWORD=demo1234
